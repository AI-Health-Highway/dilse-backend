# Core backend settings
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DB=(default)
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Enable after setting the Engagelo API key, phone number ID, and OTP hash secret.
APP_ENV=development
WHATSAPP_INTEGRATION_ENABLED=false
# Temporary fixed OTP. Local development defaults to 555666 when unset.
# For a temporary server test, set both WHATSAPP_DEV_OTP=555666 and
# ALLOW_FIXED_OTP_IN_PRODUCTION=true. Leave WHATSAPP_DEV_OTP empty for real delivery.
# A fixed OTP does not verify phone ownership; do not use it for real patient data.
WHATSAPP_DEV_OTP=
ALLOW_FIXED_OTP_IN_PRODUCTION=false
ENGAGELO_BASE_URL=https://bot.engagelo.com
ENGAGELO_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=896208526919354
ENGAGELO_OTP_TEMPLATE_ID=454203
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Generate a stable secret with a cryptographically secure password generator.
OTP_HASH_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=true

# Consent and delivery behavior
WHATSAPP_CONSENT_VERSION=2026-09-01
ENGAGELO_TIMEOUT_SECONDS=10
ENGAGELO_MAX_RETRIES=2

# OTPs use the approved Engagelo template with templateVariable-OTP-1.
# Other plain text updates require an active user-initiated WhatsApp chat.
